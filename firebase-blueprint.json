        "rank": { "type": "number" }
      },
      "required": ["id", "locationId", "staffId", "points"]
    },
    "Modifier": {
      "title": "Modifier",
      "description": "A menu item modifier like extra toppings or sides",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "locationId": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "inventoryItemId": { "type": "string" },
        "quantity": { "type": "number" },
