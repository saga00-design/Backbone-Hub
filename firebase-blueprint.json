        "locationId": { "type": "string" },
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "acknowledgedAt": { "type": "string" }
      },
      "required": ["id", "locationId", "staffId", "acknowledgedAt"]
    },
