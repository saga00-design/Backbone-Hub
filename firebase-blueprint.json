      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "locationId": { "type": "string" },
        "clockIn": { "type": "string" },
        "clockOut": { "type": "string" },
        "hourlyRateAtTime": { "type": "number" },
