            "serviceChargeTotal": { "type": "number" },
            "discountTotal": { "type": "number" },
            "totalPaid": { "type": "number" },
            "orderCount": { "type": "number" },
            "averageOrderValue": { "type": "number" }
          }
        },
        "breakdowns": {
          "type": "object",
