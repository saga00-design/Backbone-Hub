      "properties": {
        "id": { "type": "string" },
        "locationId": { "type": "string" },
        "type": { "type": "string", "enum": ["Urgent Alert", "Special", "Recommendation", "Service Note"] },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "price": { "type": "number" },
        "shift": { "type": "string", "enum": ["Lunch", "Dinner", "All Day"] },
        "roles": { "type": "array", "items": { "type": "string" } },
        "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
