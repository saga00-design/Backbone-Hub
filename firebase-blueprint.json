        "status": { "type": "string", "enum": ["Active", "Low Stock", "Unavailable (86)"] }
      },
      "required": ["id", "locationId", "menuItemId", "status"]
    },
    "BriefingAcknowledgement": {
      "title": "Briefing Acknowledgement",
