      "properties": {
        "id": { "type": "string" },
        "locationId": { "type": "string" },
        "type": { "type": "string", "enum": ["Item", "Revenue", "Behavior"] },
        "title": { "type": "string" },
        "targetValue": { "type": "number" },
        "currentValue": { "type": "number" },
        "shift": { "type": "string", "enum": ["Lunch", "Dinner", "All Day"] },
        "status": { "type": "string", "enum": ["Active", "Completed", "Expired"] }
      },
      "required": ["id", "locationId", "type", "title", "targetValue"]
    },
    "ShiftChallenge": {
      "title": "Shift Challenge",
