        "id": { "type": "string" },
        "locationId": { "type": "string" },
        "inventoryItemId": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "reason": { "type": "string" },
        "cost": { "type": "number" },
        "date": { "type": "string" },
        "staffId": { "type": "string" }
      },
      "required": ["id", "inventoryItemId", "quantity", "date"]
    },
    "BriefingItem": {
      "title": "Briefing Item",
