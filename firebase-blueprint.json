    "InventoryItem": {
      "title": "Inventory Item",
      "description": "An item in the restaurant's inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "locationId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "subCategory": { "type": "string" },
        "department": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "minStockLevel": { "type": "number" },
        "pricePerUnit": { "type": "number" },
        "lastUpdated": { "type": "string" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" },
        "expiryDate": { "type": "string" },
        "supplier": { "type": "string" },
        "supplierContact": { "type": "string" },
        "dailyUsageRate": { "type": "number" },
        "yieldFactor": { "type": "number" },
        "storageLocation": { "type": "string" },
        "priceHistory": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "date": { "type": "string" },
              "price": { "type": "number" }
            }
          }
        },
        "barcode": { "type": "string" },
        "averagePurchasePrice": { "type": "number" },
        "allergies": { "type": "array", "items": { "type": "string" } },
        "totalOwned": { "type": "number" },
        "brokenQuantity": { "type": "number" }
      },
      "required": ["id", "name", "category", "quantity", "unit", "pricePerUnit", "lastUpdated"]
    },
    "Recipe": {
      "title": "Recipe",
      "description": "A recipe or menu item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "locationId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["recipe", "menu_item"] },
        "category": { "type": "string" },
        "subCategory": { "type": "string" },
        "imageUrl": { "type": "string" },
        "sellingPrice": { "type": "number" },
        "vatRate": { "type": "number" },
        "serviceChargeRate": { "type": "number" },
        "yieldAmount": { "type": "number" },
        "yieldUnit": { "type": "string" },
        "quantity": { "type": "number" },
        "calories": { "type": "number" },
        "allergies": { "type": "array", "items": { "type": "string" } },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "inventoryItemId": { "type": "string" },
              "quantity": { "type": "number" },
              "unit": { "type": "string" },
              "baseQuantity": { "type": "number" },
              "costAtCreation": { "type": "number" }
            }
          }
        },
        "posId": { "type": "string" },
        "posCategory": { "type": "string" },
        "marginTarget": { "type": "number" },
        "lastCostUpdate": { "type": "string" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["id", "name", "sellingPrice", "ingredients", "lastUpdated"]
    },
    "MenuItem": {
      "title": "Menu Item",
      "description": "A POS-synchronized menu item mapping",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipeId": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "categoryId": { "type": "string" },
        "priceGross": { "type": "number", "description": "Price in cents" },
        "vatRate": { "type": "number" },
        "active": { "type": "boolean" },
        "locationId": { "type": "string" },
        "station": { "type": "string" },
        "isDrink": { "type": "boolean" },
        "imageUrl": { "type": "string" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["id", "recipeId", "name", "priceGross"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "A food or beverage supplier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "locationId": { "type": "string" },
        "name": { "type": "string" },
        "contactName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Order": {
      "title": "Order",
      "description": "A purchase order sent to a supplier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "locationId": { "type": "string" },
        "date": { "type": "string" },
        "supplier": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Sent", "Received"] },
        "items": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["id", "date", "supplier", "totalAmount", "status"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "A received invoice from a supplier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "locationId": { "type": "string" },
        "date": { "type": "string" },
        "vendor": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Processed"] },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Unpaid"] },
        "items": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["id", "date", "vendor", "totalAmount", "status", "paymentStatus"]
    },
    "StockCountRecord": {
      "title": "Stock Count Record",
      "description": "A record of a completed stock count",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "locationId": { "type": "string" },
        "date": { "type": "string" },
        "aiAnalysis": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["id", "date", "items"]
    },
    "SalesImportRecord": {
      "title": "Sales Import Record",
      "description": "A record of a sales data import",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "locationId": { "type": "string" },
        "date": { "type": "string" },
        "fileName": { "type": "string" },
        "totalSales": { "type": "number" },
        "foodSales": { "type": "number" },
        "beverageSales": { "type": "number" },
        "nonFbSales": { "type": "number" },
        "itemsCount": { "type": "number" },
        "matchedCount": { "type": "number" },
        "ingredientsAffected": { "type": "number" }
      },
      "required": ["id", "date", "fileName", "totalSales"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User specific settings and profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "isDarkMode": { "type": "boolean" },
        "role": { "type": "string", "enum": ["admin", "user"] }
      },
      "required": ["uid", "email"]
    },
    "Table": {
      "title": "Table",
      "description": "A restaurant table",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "zoneId": { "type": "string" },
        "seats": { "type": "number" },
        "active": { "type": "boolean" },
        "locationId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["id", "name", "zoneId", "seats", "active", "locationId", "status", "createdAt", "lastUpdated"]
    },
    "POSOrder": {
      "title": "POS Order",
      "description": "A restaurant order from the POS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "locationId": { "type": "string" },
        "tableId": { "type": "string" },
        "tableName": { "type": "string" },
        "orderNumber": { "type": "string" },
        "type": { "type": "string", "enum": ["Dine-In", "Takeaway", "Delivery"] },
        "status": { "type": "string", "enum": ["Open", "Sent", "Paid", "Cancelled", "Refunded"] },
        "items": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "menuItemId": { "type": "string" },
              "name": { "type": "string" },
              "quantity": { "type": "number" },
              "price": { "type": "number" },
              "modifiers": { "type": "array", "items": { "type": "string" } },
              "notes": { "type": "string" },
              "status": { "type": "string", "enum": ["Pending", "Cooking", "Served", "Void"] }
            }
          } 
        },
        "subtotal": { "type": "number" },
        "vat": { "type": "number" },
        "serviceCharge": { "type": "number" },
        "total": { "type": "number" },
        "tips": { "type": "number" },
        "waiterId": { "type": "string" },
        "waiterName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "paidAt": { "type": "string" },
        "paymentMethod": { "type": "string", "enum": ["Cash", "Card", "Mixed", "Other"] },
        "payments": { "type": "array", "items": { "type": "object" } },
        "isInventoryDepleted": { "type": "boolean", "description": "Flag to track if HUB has processed this for stock" }
      },
      "required": ["id", "status", "items", "total", "createdAt"]
    },
    "StaffMember": {
      "title": "Staff Member",
      "description": "A restaurant staff member",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "locationId": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Manager", "Staff", "Waiter", "Chef", "Bartender"] },
        "pin": { "type": "string" },
        "hourlyRate": { "type": "number" },
        "trainingProgress": { "type": "object" },
        "active": { "type": "boolean" },
        "performanceScore": { "type": "number" },
        "managerRating": { "type": "number" },
        "scoreTrend": { "type": "string", "enum": ["up", "down", "stable"] },
        "badges": { "type": "array", "items": { "type": "string" } },
        "completedModules": { "type": "array", "items": { "type": "string" } },
        "salaryHistory": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["id", "firstName", "lastName", "role", "pin"]
    },
    "ClockInRecord": {
      "title": "Clock In Record",
