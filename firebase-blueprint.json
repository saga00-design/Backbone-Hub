      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "locationId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["Product Push", "Sales Race", "Quality Challenge", "Team vs Team"] },
        "isActive": { "type": "boolean" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" }
      },
      "required": ["id", "locationId", "title", "type", "isActive"]
    },
