        "locationId": { "type": "string" },
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "recipeId": { "type": "string" },
        "recipeName": { "type": "string" },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "passed": { "type": "boolean" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "locationId", "staffId", "recipeId", "passed"]
    },
    "AuditLog": {
      "title": "Audit Log",
